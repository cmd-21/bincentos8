#!/bin/bash
# Hardened Terminal & SFTP Gate (PAM/Shell Wrapper Approach)
# Generate hash password baru: printf '%s' 'PasswordKamu' | sha256sum

set -e

# Buka kunci immutable lama
chattr -i /usr/local/bin/.sys-gate /etc/shells /etc/passwd 2>/dev/null || true

# 1. Buat direktori penyimpanan state sesi
mkdir -p /etc/.sysguard /dev/shm/.sysguard_allow
chmod 755 /etc/.sysguard
chmod 777 /dev/shm/.sysguard_allow

# 2. Hash Password (Ganti hash di bawah dengan password Anda)
# Default hash di bawah adalah untuk password: root
EXPECTED_HASH="8e0ba79750f8cefb4c308ae4b337d4814e5af76f86b2da5ab89808a3fd07f1aa"

# 3. Buat Wrapper Shell Aman yang Bertindak sebagai Gatekeeper
cat > /usr/local/bin/.sys-gate << 'EOF'
#!/bin/bash
# System Guard - Secure Shell & SFTP Gatekeeper

_RAW_CONN="${SSH_CLIENT:-$SSH_CONNECTION}"
_CLIENT_IP=$(printf '%s' "$_RAW_CONN" | awk '{print $1}')
[ -z "$_CLIENT_IP" ] && _CLIENT_IP="local"

_ALLOW_DIR="/dev/shm/.sysguard_allow"
_ALLOW_FILE="${_ALLOW_DIR}/${_CLIENT_IP}"

# Fungsi cek apakah IP ini sudah unlock via terminal aktif
is_unlocked() {
  [ ! -f "$_ALLOW_FILE" ] && return 1
  while IFS= read -r _pid; do
    if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
      return 0
    fi
  done < "$_ALLOW_FILE"
  rm -f "$_ALLOW_FILE" 2>/dev/null || true
  return 1
}

# Jika ini akses SFTP / Non-interaktif (SCP / rsync)
if [ ! -t 0 ] && [ ! -t 1 ]; then
  if is_unlocked; then
    for b in /usr/libexec/openssh/sftp-server /usr/lib/openssh/sftp-server /usr/lib/ssh/sftp-server; do
      [ -x "$b" ] && exec "$b"
    done
  fi
  exit 1
fi

# Jika akses Terminal Interaktif
# Bersihkan sinyal interupsi
trap '' INT TSTP QUIT HUP TERM USR1 USR2 PIPE ALRM

EXPECTED_HASH="8e0ba79750f8cefb4c308ae4b337d4814e5af76f86b2da5ab89808a3fd07f1aa"
MAX_ATTEMPTS=5
TIMEOUT_SEC=60

# Tampilkan Banner
printf '\033[1;35m' > /dev/tty 2>/dev/null
cat > /dev/tty << 'BANNER' 2>/dev/null
$$$$$$$\  $$\   $$\  $$$$$$\        $$$$$$$\   $$$$$$\   $$$$$$\  $$$$$$$$\ 
$$  __$$\ $$ |  $$ |$$  __$$\       $$  __$$\ $$  __$$\ $$  __$$\ $$  _____|
$$ |  $$ |$$ |  $$ |$$ /  $$ |      $$ |  $$ |$$ /  $$ |$$ /  \__|$$ |      
$$ |  $$ |$$$$$$$$ |\$$$$$$$ |      $$$$$$$\ |$$$$$$$$ |\$$$$$$\  $$$$$\ ./DarkNET = By Dark-AI
$$ |  $$ |\_____$$ | \____$$ |      $$  __$$\ $$  __$$ | \____$$\ $$  __|   
$$ |  $$ |      $$ |$$\   $$ |      $$ |  $$ |$$ |  $$ |$$\   $$ |$$ |      
$$$$$$$  |      $$ |\$$$$$$  |      $$$$$$$  |$$ |  $$ |\$$$$$$  |$$$$$$$$\ 
\_______/       \__| \______/       \_______/ \__|  \__| \______/ \________|
BANNER
printf '\033[0m' > /dev/tty 2>/dev/null

ATTEMPT=0
while :; do
  ATTEMPT=$((ATTEMPT + 1))
  if [ "$ATTEMPT" -gt "$MAX_ATTEMPTS" ]; then
    printf '\n\033[1;31mTerlalu banyak percobaan gagal! Memutus koneksi.\033[0m\n' > /dev/tty 2>/dev/null
    sleep 1
    exit 1
  fi

  printf 'Password: ' > /dev/tty 2>/dev/null
  stty -echo < /dev/tty 2>/dev/null || true

  if ! IFS= read -r -t "$TIMEOUT_SEC" input < /dev/tty; then
    printf '\n\033[1;31mTimeout / Input Invalid!\033[0m\n' > /dev/tty 2>/dev/null
    exit 1
  fi

  printf '\n' > /dev/tty 2>/dev/null
  stty echo < /dev/tty 2>/dev/null || true

  if [ -z "$input" ]; then
    printf '\033[1;31mMatane Picek!!! (%d/%d)\033[0m\n' "$ATTEMPT" "$MAX_ATTEMPTS" > /dev/tty 2>/dev/null
    continue
  fi

  HASH=$(printf '%s' "$input" | sha256sum | awk '{print $1}' 2>/dev/null)
  unset input

  if [ "$HASH" = "$EXPECTED_HASH" ]; then
    mkdir -p "$_ALLOW_DIR" 2>/dev/null || true
    chmod 777 "$_ALLOW_DIR" 2>/dev/null || true
    echo "$$" >> "$_ALLOW_FILE" 2>/dev/null || true
    chmod 666 "$_ALLOW_FILE" 2>/dev/null || true

    printf '\033[1;32m[OK] Akses Terminal & SFTP Dibuka (PID: %s | IP: %s)\033[0m\n\n' "$$" "$_CLIENT_IP" > /dev/tty 2>/dev/null

    # Cleanup trap dan serahkan kontrol ke bash normal
    trap - INT TSTP QUIT HUP TERM USR1 USR2 PIPE ALRM
    
    # Hapus PID dari allow file saat terminal ini ditutup
    trap 'sed -i "/^$$$/d" "$_ALLOW_FILE" 2>/dev/null; [ ! -s "$_ALLOW_FILE" ] && rm -f "$_ALLOW_FILE" 2>/dev/null' EXIT
    break
  else
    printf '\033[1;31mMatane Picek!!! (%d/%d)\033[0m\n' "$ATTEMPT" "$MAX_ATTEMPTS" > /dev/tty 2>/dev/null
    sleep 1
  fi
done

# Masuk ke shell asli dengan bersih tanpa gangguan descriptor
exec /bin/bash --login
EOF

chmod 755 /usr/local/bin/.sys-gate
chattr +i /usr/local/bin/.sys-gate 2>/dev/null

# 4. Daftarkan wrapper ke /etc/shells agar diizinkan sistem
if ! grep -q "/usr/local/bin/.sys-gate" /etc/shells; then
  echo "/usr/local/bin/.sys-gate" >> /etc/shells
fi

# 5. Ubah shell user root menjadi wrapper keamanan ini
chsh -s /usr/local/bin/.sys-gate root 2>/dev/null || sed -i 's|^\(root:x:[0-9]*:[0-9]*:.*:.*\):.*$|\1:/usr/local/bin/.sys-gate|' /etc/passwd

echo "✅ Sistem Lockterminal Anti-Bypass Berhasil Diaktifkan!"
